  "directoryUpdated": "ಡೈರೆಕ್ಟರಿ ನವೀಕರಿಸಲಾಗಿದೆ: {count} ಕಚೇರಿಗಳು",
  "help1Title": "ನಿಮ್ಮ ಸ್ಕೀಮ್ ಆಮದು ಮಾಡಿ",
  "help1": "ಇನ್ನಷ್ಟು → ಸಾರ್ಟಿಂಗ್ ಸ್ಕೀಮ್‌ಗಳು → ಸೇರಿಸಿ. ನಿಮ್ಮ ಕಚೇರಿಯ Excel/CSV ಆಯ್ಕೆಮಾಡಿ, ಕಾಲಂಗಳನ್ನು ಪರಿಶೀಲಿಸಿ ಉಳಿಸಿ. ಫೈಲ್ ಇಲ್ಲವೇ? ಟೆಂಪ್ಲೇಟ್ ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ ಅಥವಾ ಮಾದರಿ ಸ್ಕೀಮ್ (ನಕಲಿ ಮಾಹಿತಿ) ಪ್ರಯತ್ನಿಸಿ.",
  "help2Title": "ಪಿನ್ ಮೂಲಕ ಸಾರ್ಟ್",
  "help2": "ದೊಡ್ಡ ಕೀಪ್ಯಾಡ್‌ನಲ್ಲಿ ಪಿನ್ ಟೈಪ್ ಮಾಡಿ. 3 ಅಂಕಿಗಳ ನಂತರ ಸಾರ್ಟಿಂಗ್ ಜಿಲ್ಲೆ ಮತ್ತು ಸಂಭವನೀಯ ಚೀಲ; 6 ಅಂಕಿಗಳ ನಂತರ ಅಂತಿಮ ಚೀಲ ಅದರ ಬಣ್ಣದಲ್ಲಿ. ಮುಂದಿನ ಅಂಕಿ ಟೈಪ್ ಮಾಡಿದರೆ ಹೊಸ ಪಿನ್ ಪ್ರಾರಂಭ. ಅಳಿಸಲು ⌫ ದೀರ್ಘವಾಗಿ ಒತ್ತಿ.",
  "help3Title": "TD ಮತ್ತು ನಾನ್-TD",
  "help3": "ಸಾರ್ಟ್ ಪರದೆಯ ಮೇಲ್ಭಾಗದಲ್ಲಿ TD ಅಥವಾ ನಾನ್-TD ಆಯ್ಕೆಮಾಡಿ. ನಿಮ್ಮ ಸ್ಕೀಮ್‌ನ ಪ್ರತಿ ನಿಯಮವನ್ನು Category ಕಾಲಂನಲ್ಲಿ TD ಅಥವಾ Non-TD ಎಂದು ಗುರುತಿಸಬಹುದು (ಖಾಲಿ = ಎರಡೂ). ಪಿನ್‌ಗೆ ಇನ್ನೊಂದು ಮೋಡ್‌ನಲ್ಲಿ ಮಾತ್ರ ನಿಯಮವಿದ್ದರೆ, ಆ್ಯಪ್ ಯಾವ ಮೋಡ್ ಮತ್ತು ಚೀಲ ಎಂದು ತಿಳಿಸುತ್ತದೆ.",
  "help4Title": "ವಸ್ತುವಿನಲ್ಲಿ ಪಿನ್ ಇಲ್ಲವೇ?",
  "help4": "ಪಿನ್ ಹುಡುಕಿ: ಕಚೇರಿ, ಗ್ರಾಮ, ನಗರ, ತಾಲ್ಲೂಕು ಅಥವಾ ಜಿಲ್ಲೆಯನ್ನು ಇಂಗ್ಲಿಷ್, ಕನ್ನಡ ಅಥವಾ ಹಿಂದಿಯಲ್ಲಿ ಟೈಪ್ ಮಾಡಿ. ಕಾಗುಣಿತ ತಪ್ಪುಗಳನ್ನು ಸಹಿಸುತ್ತದೆ. ಪ್ರತಿ ಫಲಿತಾಂಶ ಅದರ ಚೀಲ ತೋರಿಸುತ್ತದೆ.",
  "help5Title": "ತಪ್ಪು ಪಿನ್ ಪತ್ತೆಹಚ್ಚಿ",
  "help5": "ಸ್ಥಳ ಪರಿಶೀಲನೆ ಆನ್ ಮಾಡಿ (ಸಾರ್ಟ್‌ನಲ್ಲಿ ✓ ಐಕಾನ್) ಮತ್ತು ವಸ್ತುವಿನ ಮೇಲೆ ಬರೆದ ನಗರ ಟೈಪ್ ಮಾಡಿ. ✅ ಹೊಂದಿಕೆ, ⚠️ ಅದೇ ಜಿಲ್ಲೆ ಆದರೆ ಬೇರೆ ಪಿನ್, ❌ ಬೇರೆ ಜಿಲ್ಲೆ/ರಾಜ್ಯ – ಸೂಚಿಸಿದ ಪಿನ್‌ಗಳೊಂದಿಗೆ.",
  "help6Title": "ವಿಳಾಸ ಸ್ಕ್ಯಾನ್ ಮಾಡಿ",
  "help6": "ಸ್ಕ್ಯಾನ್ ಐಕಾನ್ ಒತ್ತಿ, ಕ್ಯಾಮೆರಾವನ್ನು ವಿಳಾಸದ ಕಡೆ ಹಿಡಿದು ಕ್ಯಾಪ್ಚರ್ ಮಾಡಿ. ಪಿನ್ ಮತ್ತು ನಗರವನ್ನು ಫೋನಿನಲ್ಲೇ ಓದಲಾಗುತ್ತದೆ; ಫೋಟೋ ತಕ್ಷಣ ಅಳಿಸಲಾಗುತ್ತದೆ.",
  "help7Title": "ಚೀಲವಾರು ವಸ್ತುಗಳನ್ನು ಎಣಿಸಿ",
  "help7": "ಗುಂಪು → ಸೆಷನ್ ಪ್ರಾರಂಭಿಸಿ. ಪಿನ್‌ಗಳನ್ನು ಒಂದರ ನಂತರ ಒಂದು ನಮೂದಿಸಿ; ಪ್ರತಿಯೊಂದೂ ಅದರ ಚೀಲದ ಬಣ್ಣ ಮಿಂಚಿಸಿ ಎಣಿಕೆಗೆ ಸೇರುತ್ತದೆ. ಕೊನೆಯದನ್ನು ರದ್ದುಮಾಡಿ, ಪರಿಹರಿಸದವನ್ನು ಸರಿಪಡಿಸಿ, ನಂತರ ಮ್ಯಾನಿಫೆಸ್ಟ್‌ನೊಂದಿಗೆ ತಾಳೆ ಮಾಡಲು ಸಾರಾಂಶ ಹಂಚಿ.",
  "help8Title": "ಅಭ್ಯಾಸ ಮಾಡಿ",
  "help8": "ಅಭ್ಯಾಸ: ಅಂತರದ ಪುನರಾವರ್ತನೆಯ ಫ್ಲ್ಯಾಶ್‌ಕಾರ್ಡ್‌ಗಳು, 20 ವಸ್ತುಗಳ ಸಮಯದ ರಸಪ್ರಶ್ನೆ, ದುರ್ಬಲ ಭಾಗಗಳು ಮತ್ತು ಪಿನ್ ಮೂಲಭೂತ ಪಾಠ. ಹೊಸ DMSL ನಂತರ ಹಬ್ ಬದಲಾದ ಪಿನ್‌ಗಳನ್ನು ಮಾತ್ರ ಅಭ್ಯಾಸ ಮಾಡಿ.",
  "help9Title": "ಸಾರ್ಟಿಂಗ್ ಬದಲಾಗಿದೆಯೇ? ಬದಲಿಸಿ",
  "help9": "ಒಂದು ಪಿನ್ ಸರಿಪಡಿಸಲು ಸಾರ್ಟ್ ಪರದೆಯಲ್ಲಿ “ಈ ಪಿನ್‌ನ ಚೀಲ ಬದಲಿಸಿ” ಒತ್ತಿ. ದೊಡ್ಡ ಬದಲಾವಣೆಗಳಿಗೆ ಇನ್ನಷ್ಟು → ಸ್ಕೀಮ್‌ಗಳು → ನಿಮ್ಮ ಸ್ಕೀಮ್ ತೆರೆಯಿರಿ: ನಿಯಮಗಳನ್ನು ಬದಲಿಸಿ, ಸೇರಿಸಿ ಅಥವಾ ಅಳಿಸಿ. ಕಚೇರಿ ಹೊಸ ಲೈನ್‌ಗೆ ಹೋದಾಗ ಚೀಲಗಳಲ್ಲಿ “ನಿಯಮಗಳನ್ನು ಬೇರೆ ಚೀಲಕ್ಕೆ ಸರಿಸಿ” ಬಳಸಿ. ಸಹೋದ್ಯೋಗಿಗಳೊಂದಿಗೆ ಹಂಚಲು ಸ್ಕೀಮ್ ರಫ್ತು ಮಾಡಿ."
