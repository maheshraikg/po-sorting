  "legalTitle": "ಹಕ್ಕು ನಿರಾಕರಣೆ ಮತ್ತು ಗೌಪ್ಯತಾ ನೀತಿ",
  "legalSub": "ಸ್ವತಂತ್ರ ಸಾಧನ · ಅಧಿಕೃತ ಆ್ಯಪ್ ಅಲ್ಲ · ಆಫ್‌ಲೈನ್",
  "acceptLegal": "ಒಪ್ಪುತ್ತೇನೆ",
  "readFullPolicy": "ಪೂರ್ಣ ನೀತಿ ಓದಿ",
  "legalH1": "ಸ್ವತಂತ್ರ ಸಾಧನ",
  "legal1": "ಪಿಒ ಸಾರ್ಟಿಂಗ್ ಅಂಚೆ ಸಿಬ್ಬಂದಿಗಾಗಿ ಮಾಡಿದ ಸ್ವತಂತ್ರ ಸಹಾಯಕ ಸಾಧನ. ಇದು ಅಂಚೆ ಇಲಾಖೆ / ಇಂಡಿಯಾ ಪೋಸ್ಟ್‌ನ ಅಧಿಕೃತ ಆ್ಯಪ್ ಅಲ್ಲ ಮತ್ತು ಅಂಚೆ ಇಲಾಖೆ, ಸಂವಹನ ಸಚಿವಾಲಯ ಅಥವಾ ಭಾರತ ಸರ್ಕಾರದೊಂದಿಗೆ ಯಾವುದೇ ಸಂಬಂಧ ಅಥವಾ ಅನುಮೋದನೆ ಹೊಂದಿಲ್ಲ.",
  "legalH2": "ಅಧಿಕೃತ ಬ್ರ್ಯಾಂಡಿಂಗ್ ಇಲ್ಲ",
  "legal2": "ಈ ಆ್ಯಪ್ ಇಂಡಿಯಾ ಪೋಸ್ಟ್ ಹೆಸರು, ಲೋಗೋ, ಬಣ್ಣಗಳು ಅಥವಾ ಬ್ರ್ಯಾಂಡಿಂಗ್ ಬಳಸುವುದಿಲ್ಲ. ಅಂಚೆ ಕಚೇರಿಗಳ ಹೆಸರು ಮತ್ತು ಪಿನ್ ಕೋಡ್‌ಗಳನ್ನು ಸಾರ್ವಜನಿಕ ಉಲ್ಲೇಖ ಮಾಹಿತಿಯಾಗಿ ಮಾತ್ರ ಬಳಸಲಾಗಿದೆ.",
  "legalH3": "ಖಾತರಿ ಇಲ್ಲ",
  "legal3": "ಸಾರ್ಟಿಂಗ್ ಮಾಹಿತಿ, ಪಿನ್ ವಿವರಗಳು ಮತ್ತು ವಿಮಾನ ನಿಲ್ದಾಣ ಕೋಡ್‌ಗಳನ್ನು ಅನುಕೂಲಕ್ಕಾಗಿ “ಇದ್ದಂತೆ” ನೀಡಲಾಗಿದೆ; ಅವು ಹಳೆಯದು ಅಥವಾ ತಪ್ಪಾಗಿರಬಹುದು. ಯಾವಾಗಲೂ ನಿಮ್ಮ ಕಚೇರಿಯ ಅಧಿಕೃತ ಸಾರ್ಟಿಂಗ್ ಸೂಚನೆಗಳು, ಸುತ್ತೋಲೆಗಳು ಮತ್ತು DMSL ಅನುಸರಿಸಿ. ಈ ಆ್ಯಪ್ ಬಳಕೆಯಿಂದ ಆಗುವ ತಪ್ಪು ಸಾರ್ಟಿಂಗ್, ವಿಳಂಬ, ನಷ್ಟ ಅಥವಾ ಇತರ ಪರಿಣಾಮಗಳಿಗೆ ಡೆವಲಪರ್ ಜವಾಬ್ದಾರರಲ್ಲ.",
  "legalH4": "ನಿಮ್ಮ ಜವಾಬ್ದಾರಿ",
  "legal4": "ನೀವು ಆಮದು, ಬದಲಾವಣೆ ಅಥವಾ ಹಂಚಿಕೊಳ್ಳುವ ಮಾಹಿತಿಗೆ ಮತ್ತು ಆಂತರಿಕ ದಾಖಲೆಗಳ ಹಂಚಿಕೆ ಕುರಿತ ಇಲಾಖೆಯ ನಿಯಮ ಪಾಲನೆಗೆ ನೀವೇ ಜವಾಬ್ದಾರರು.",
  "legalH5": "ಗೌಪ್ಯತೆ",
  "legal5": "ಆ್ಯಪ್ ಸಂಪೂರ್ಣ ಆಫ್‌ಲೈನ್. ಇಂಟರ್ನೆಟ್ ಅನುಮತಿ, ಲಾಗಿನ್, ಜಾಹೀರಾತು, ಅನಾಲಿಟಿಕ್ಸ್ ಅಥವಾ ಟ್ರ್ಯಾಕಿಂಗ್ ಇಲ್ಲ. ಕ್ಯಾಮೆರಾ ಸ್ಕ್ಯಾನ್ ಫೋನ್‌ನಲ್ಲೇ ಪ್ರಕ್ರಿಯೆಗೊಂಡು ತಕ್ಷಣ ಅಳಿಸಲಾಗುತ್ತದೆ; ಏನನ್ನೂ ಅಪ್‌ಲೋಡ್ ಮಾಡುವುದಿಲ್ಲ. ನಿಮ್ಮ ಸ್ಕೀಮ್‌ಗಳು, ಮೆಚ್ಚಿನವು ಮತ್ತು ಸೆಟ್ಟಿಂಗ್‌ಗಳು ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲೇ ಇರುತ್ತವೆ ಮತ್ತು ಆ್ಯಪ್ ಅನ್‌ಇನ್‌ಸ್ಟಾಲ್ ಮಾಡಿದಾಗ ಅಳಿಸಲ್ಪಡುತ್ತವೆ.",
  "legalH6": "ಮುಕ್ತ ಮಾಹಿತಿ",
  "legal6": "ಪಿನ್ ಡೈರೆಕ್ಟರಿ: data.gov.in, ಭಾರತ ಸರ್ಕಾರ, ಓಪನ್ ಗವರ್ನ್‌ಮೆಂಟ್ ಡೇಟಾ ಲೈಸೆನ್ಸ್ – ಇಂಡಿಯಾ. ವಿಮಾನ ನಿಲ್ದಾಣ ಕೋಡ್‌ಗಳು ಸಾರ್ವಜನಿಕ IATA ಕೋಡ್‌ಗಳು. ಡೀಫಾಲ್ಟ್ ಮಂಗಳೂರು ಸ್ಕೀಮ್ ಅಂಚೆ ಸಿಬ್ಬಂದಿ ಹಂಚಿಕೊಂಡ ಪಟ್ಟಿಗಳಿಂದ ತಯಾರಾಗಿದ್ದು ನಿಮ್ಮ ಕಚೇರಿಯ ಈಗಿನ ಸ್ಕೀಮ್‌ಗಿಂತ ಭಿನ್ನವಾಗಿರಬಹುದು.",
